<% layout("/layouts/boilerplate")%>

<%- include("../includes/breadcrumbs.ejs", { crumbs: [{ label: "Home", href: "/" }, { label: "Properties", href: "/listings" }, { label: listing.title, href: "/listings/" + listing._id }, { label: "Edit" }] }) %>

<div class="form-page-wide">
  <div class="form-card">
    <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-eh-outline mb-3 back-link">&larr; Back to listing</a>
    <h1 class="h2">Edit your Listing</h1>
    <p class="lead-sm">Update the details below, then choose Save Changes.</p>

    <form
      id="edit-listing-form"
      data-unsaved-guard
      method="POST"
      action="/listings/<%= listing._id %>?_method=PUT"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          id="title"
          name="listing[title]"
          value="<%= listing.title %>"
          type="text"
          class="form-control"
          maxlength="100"
          required
        />
        <div class="invalid-feedback">Enter a title.</div>
      </div>
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea id="description" name="listing[description]" class="form-control" rows="4" maxlength="2000" required><%= listing.description %></textarea>
        <div class="invalid-feedback">Enter a description.</div>
      </div>

      <div class="mb-3">
        <span class="form-label d-block">Original Listing Image</span>
        <% if (originalImageUrl) { %>
          <img src="<%= originalImageUrl %>" class="rounded border current-photo" alt="Current photo of this listing" />
        <% } else { %>
          <span class="text-muted">No image uploaded yet.</span>
        <% } %>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Upload New Image</label>
        <input id="image" name="listing[image]" type="file" accept="image/png,image/jpeg,image/webp" class="form-control" aria-describedby="image-help" />
        <div id="image-help" class="form-text">Optional. PNG, JPG or WebP, up to 5 MB.</div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input
            id="price"
            name="listing[price]"
            value="<%= listing.price %>"
            type="number"
            min="1"
            max="100000"
            step="any"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Enter a valid price.</div>
        </div>
        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country</label>
          <input
            id="country"
            name="listing[country]"
            value="<%= listing.country %>"
            type="text"
            class="form-control"
            maxlength="60"
            required
          />
          <div class="invalid-feedback">Enter a country.</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input
          id="location"
          name="listing[location]"
          value="<%= listing.location %>"
          type="text"
          class="form-control"
          maxlength="100"
          required
        />
        <div class="invalid-feedback">Enter a location.</div>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-3 mt-4">
        <button type="submit" class="btn btn-eh btn-lg">Save Changes</button>
        <a href="/listings/<%= listing._id %>" class="btn btn-eh-outline btn-lg">Cancel</a>
        <span id="unsaved-notice" class="text-danger small d-none" role="status">You have unsaved changes.</span>
      </div>
    </form>
  </div>
</div>

<script src="/js/unsaved-guard.js"></script>
