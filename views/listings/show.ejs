<% layout("layouts/boilerplate") %>
<% const img = photo(listing); const isOwnerView = Boolean(currUser && listing.owner && listing.owner._id.equals(currUser._id)); %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  // Only the fields map.js needs; "<", ">", "&" and line separators are escaped so the JSON cannot close the script tag.
  const listing = <%- JSON.stringify({ title: listing.title, geometry: listing.geometry, isDemo: Boolean(listing.isDemo) })
    .replace(/</g, "\\u003c").replace(/>/g, "\\u003e").replace(/&/g, "\\u0026")
    .replace(/\u2028/g, "\\u2028").replace(/\u2029/g, "\\u2029") %>;
</script>

<%- include("../includes/breadcrumbs.ejs", { crumbs: [{ label: "Home", href: "/" }, { label: "Properties", href: "/listings" }, { label: listing.title }] }) %>

<p class="mb-3">
  <a href="/listings" class="btn btn-sm btn-eh-outline back-link">&larr; Back to Listings</a>
</p>

<div class="row g-4">
  <div class="col-lg-8">
    <figure class="property-hero is-loading-img">
      <img
        src="<%= img.src %>"
        alt="<%= img.alt %>"
        width="900"
        height="675"
        decoding="async"
        onload="this.parentNode.classList.remove('is-loading-img')"
        onerror="this.onerror=null;this.src='/images/placeholder-property.svg';this.parentNode.classList.remove('is-loading-img')"
      />
      <% if (listing.isDemo) { %><span class="sample-badge">Sample listing</span><% } %>
    </figure>
    <% if (img.illustrative && img.credit) { %>
      <p class="photo-credit">Illustrative stock photo by <%= img.credit %> on Unsplash. It does not show the actual property.</p>
    <% } %>

    <h1 class="mb-1"><%= listing.title %></h1>
    <p class="property-location">
      <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
      <%= listing.location %>, <%= listing.country %>
    </p>

    <% if (listing.isDemo) { %>
      <div class="sample-notice" role="note">
        <b>Sample listing.</b> This is an illustration for demonstration only. It is not a real property, is not
        available for booking, and is not an actual offer.
      </div>
    <% } %>

    <h2 class="h5 mt-4">About this property</h2>
    <p class="mb-0"><%= listing.description %></p>

    <dl class="property-facts">
      <div><dt>Location</dt><dd><%= listing.location %></dd></div>
      <div><dt>Country</dt><dd><%= listing.country %></dd></div>
      <div><dt>Price per night</dt><dd>&#8377; <%= (Number(listing.price) || 0).toLocaleString("en-IN") %></dd></div>
      <div>
        <dt>Owner</dt>
        <dd>
          <% if (listing.owner) { %>
            <b><%= listing.owner.username %></b>
          <% } else if (listing.isDemo) { %>
            Elites Hub (sample listing)
          <% } else { %>
            Owner unavailable
          <% } %>
        </dd>
      </div>
    </dl>
  </div>

  <aside class="col-lg-4" aria-label="Pricing and actions">
    <div class="booking-card sticky-lg-top sticky-offset">
      <p class="price">&#8377; <%= (Number(listing.price) || 0).toLocaleString("en-IN") %> <small>/ night</small></p>
      <% if (isOwnerView) { %>
        <p class="text-muted small mt-2">This is your listing.</p>
        <div class="d-grid gap-2 mt-3">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-eh">Edit</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-grid"
            onsubmit="return confirm('Delete this listing? This cannot be undone.')">
            <button type="submit" class="btn btn-eh-danger">Delete</button>
          </form>
        </div>
      <% } else if (!listing.isDemo) { %>
        <div class="d-grid mt-3">
          <a href="/listings/<%= listing._id %>/book" class="btn btn-eh btn-lg">Book</a>
        </div>
        <p class="text-muted small mt-2 mb-0">You can review your dates and price before paying.</p>
      <% } else { %>
        <p class="text-muted small mt-2 mb-0">Sample listings cannot be booked.</p>
      <% } %>
    </div>
  </aside>
</div>

<section class="mt-5" aria-labelledby="reviews-heading">
  <h2 id="reviews-heading" class="h4">Reviews</h2>
  <div class="row g-4">
    <% if (currUser) { %>
      <div class="col-lg-5">
        <h3 class="h6">Leave a review</h3>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
          <div class="mb-3 mt-3">
            <span class="form-label d-block" id="rating-label">Rating</span>
            <fieldset class="starability-slot" aria-labelledby="rating-label">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>
          <div class="mb-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" required></textarea>
            <div class="invalid-feedback">Comment box cannot be empty</div>
          </div>
          <button type="submit" class="btn btn-eh">Submit review</button>
        </form>
      </div>
    <% } %>
    <div class="<%= currUser ? "col-lg-7" : "col-12" %>">
      <% if (listing.reviews.length > 0) { %>
        <div class="row g-3">
          <% for (const review of listing.reviews) { %>
            <div class="col-12 col-md-6 col-lg-12 col-xl-6">
              <div class="review-card">
                <h3 class="h6 mb-1">@<%= review.author ? review.author.username : "deleted user" %></h3>
                <p class="starability-result mb-2" data-rating="<%= review.rating %>"><span class="visually-hidden">Rated <%= review.rating %> out of 5</span></p>
                <p class="mb-2"><%= review.comment %></p>
                <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                  <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button type="submit" class="btn btn-sm btn-eh-danger">Delete</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <p class="text-muted mb-0">No reviews yet.</p>
      <% } %>
    </div>
  </div>
</section>

<section class="mt-5" aria-labelledby="map-heading">
  <h2 id="map-heading" class="h4">Location</h2>
  <div id="map" role="region" aria-label="Map showing the approximate location of this property"></div>
  <p class="small text-muted mt-2">Approximate location only.</p>
</section>
<script src="/js/map.js"></script>
