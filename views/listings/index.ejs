<% layout("layouts/boilerplate") %>

<%- include("../includes/breadcrumbs.ejs", { crumbs: [{ label: "Home", href: "/" }, { label: "Properties" }] }) %>

<div class="page-header">
  <h1>Properties</h1>
  <p>Search by city and price. Listings marked &ldquo;Sample listing&rdquo; are fictional examples.</p>
</div>

<form action="/listings" method="get" class="search-panel" role="search" aria-label="Search and filter properties" data-loading-form>
  <div class="row g-3 align-items-end">
    <div class="col-12 col-md-5">
      <label for="q" class="form-label">City or location</label>
      <input id="q" name="q" type="search" class="form-control" maxlength="100" placeholder="e.g. Bengaluru, Jaipur" value="<%= filters.q %>" />
    </div>
    <div class="col-6 col-md-2">
      <label for="minPrice" class="form-label">Min price (&#8377;)</label>
      <input id="minPrice" name="minPrice" type="number" min="0" step="any" inputmode="numeric" class="form-control" value="<%= filters.minPrice %>" />
    </div>
    <div class="col-6 col-md-2">
      <label for="maxPrice" class="form-label">Max price (&#8377;)</label>
      <input id="maxPrice" name="maxPrice" type="number" min="0" step="any" inputmode="numeric" class="form-control" value="<%= filters.maxPrice %>" />
    </div>
    <div class="col-12 col-md-3 d-grid">
      <button class="btn btn-eh" type="submit" data-loading-text="Searching&hellip;">Search</button>
    </div>
  </div>
</form>

<div class="popular-cities chip-row mt-3" aria-label="Popular cities">
  <span class="small text-muted">Popular cities:</span>
  <% popularCities.forEach(function (c) { %>
    <a class="chip" href="<%= c.url %>"><%= c.name %></a>
  <% }) %>
</div>

<% if (searchCity) { %>
  <p class="small text-muted mt-3 mb-0 search-note">Showing results for <b><%= searchCity %></b></p>
<% } %>

<div class="filter-notices mt-3">
  <% notices.forEach(function (notice) { %>
    <div class="alert alert-warning py-2 notice" role="alert"><%= notice %></div>
  <% }) %>
</div>

<% if (activeFilters.length) { %>
  <div class="active-filters chip-row mt-3" aria-label="Active filters">
    <span class="small text-muted">Active filters:</span>
    <% activeFilters.forEach(function (f) { %>
      <a class="chip chip-active" href="<%= f.removeUrl %>" title="Remove this filter"><%= f.label %> &times;</a>
    <% }) %>
    <a href="/listings" class="small clear-filters">Clear Filters</a>
  </div>
<% } %>

<% if (allListings.length) { %>
  <div class="results-bar">
    <p class="result-count" role="status">
      <%= allListings.length %> propert<%= allListings.length === 1 ? "y" : "ies" %> found
    </p>
    <div class="form-check form-switch tax-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault" />
      <label class="form-check-label" for="flexSwitchCheckDefault">Show prices including GST</label>
    </div>
  </div>
  <div class="property-grid">
    <% for (let listing of allListings) { %>
      <%- include("../includes/listing-card.ejs", { listing, photo }) %>
    <% } %>
  </div>
<% } else if (activeFilters.length) { %>
  <div class="empty-state empty-results" role="status">
    <span class="empty-icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
    <h2 class="h4">No properties match your search</h2>
    <p>Try a different location, widen the price range, or clear your filters to see everything.</p>
    <a href="/listings" class="btn btn-eh">Clear Filters &amp; Explore All Properties</a>
  </div>
<% } else { %>
  <div class="empty-state empty-listings" role="status">
    <span class="empty-icon" aria-hidden="true"><i class="fa-solid fa-house"></i></span>
    <h2 class="h4">No properties have been listed yet</h2>
    <p>Be the first to list a property.</p>
    <a href="/listings/new" class="btn btn-eh">List Your Property</a>
  </div>
<% } %>

<script>
  (function () {
    var taxSwitch = document.getElementById("flexSwitchCheckDefault");
    if (!taxSwitch) return;
    taxSwitch.addEventListener("change", function () {
      var infos = document.getElementsByClassName("tax-info");
      for (var i = 0; i < infos.length; i++) {
        infos[i].style.display = taxSwitch.checked ? "inline" : "none";
      }
    });
  })();
</script>
