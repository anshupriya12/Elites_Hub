<% layout("/layouts/boilerplate") %>

<%
  const day = (d) => d.toISOString().slice(0, 10);
  const status = booking.paymentStatus;
  const pill = status === "paid" ? "status-paid" : status === "failed" ? "status-failed" : "status-pending";
  const label = status === "paid" ? "Paid" : status === "failed" ? "Payment failed" : "Payment pending";
%>

<%- include("../includes/breadcrumbs.ejs", { crumbs: [{ label: "Home", href: "/" }, { label: "Properties", href: "/listings" }, { label: "Booking" }] }) %>

<div class="form-page">
  <div class="form-card">
    <h1 class="h2 text-center">Booking <%= status === "paid" ? "Confirmed" : "Details" %></h1>
    <p class="text-center"><span class="status-pill <%= pill %>"><%= label %></span></p>

    <% if (status === "failed") { %>
      <div class="alert alert-danger">The payment did not go through. You have not been charged for a confirmed booking.
        <a href="/listings/<%= booking.listing ? booking.listing._id : "" %>/book">Try again</a>.</div>
    <% } else if (status === "created") { %>
      <div class="alert alert-warning">This booking has not been paid yet.</div>
    <% } %>

    <table class="table booking-table">
      <tbody>
        <tr><th scope="row">Property</th><td><%= booking.listing ? booking.listing.title : "Listing no longer available" %></td></tr>
        <% if (booking.listing) { %>
          <tr><th scope="row">Location</th><td><%= booking.listing.location %>, <%= booking.listing.country %></td></tr>
        <% } %>
        <tr><th scope="row">Check-in</th><td><%= day(booking.checkIn) %></td></tr>
        <tr><th scope="row">Check-out</th><td><%= day(booking.checkOut) %></td></tr>
        <tr><th scope="row">Nights</th><td><%= booking.nights %></td></tr>
        <tr><th scope="row">Guests</th><td><%= booking.guests %></td></tr>
        <tr><th scope="row">Amount</th><td><%= (booking.currency === "INR" ? "₹" : booking.currency + " ") + (booking.amount / 100).toLocaleString("en-IN") %></td></tr>
        <tr><th scope="row">Booking ID</th><td><code><%= booking._id %></code></td></tr>
        <% if (booking.razorpayOrderId) { %>
          <tr><th scope="row">Order ID</th><td><code><%= booking.razorpayOrderId %></code></td></tr>
        <% } %>
        <% if (booking.razorpayPaymentId) { %>
          <tr><th scope="row">Payment ID</th><td><code><%= booking.razorpayPaymentId %></code></td></tr>
        <% } %>
      </tbody>
    </table>

    <div class="d-flex flex-wrap justify-content-center gap-2">
      <a href="/listings" class="btn btn-eh">Back to listings</a>
      <a href="/" class="btn btn-eh-outline">Back to Home</a>
    </div>
  </div>
</div>
